# Port the server listens on
PORT=3000
# MongoDB connection string (required)
MONGODB_URI=mongodb://localhost:27017/baby-tasting-dev
# Secret for signing session cookies (required in production)
SESSION_SECRET=change-me
# The two parents, comma-separated, each as name:bcryptHash (required in production).
# The first entry is parent A, the second parent B. A name without :hash stops the server at startup.
# Make a hash (run inside server/, replace pw with the password):
#   node -e "import('bcryptjs').then(b=>b.hash('pw',10).then(console.log))"
# The end-to-end users (passwords test-pass-a and test-pass-b) for the worktree slots:
APP_USERS=parent-a:$2b$10$HyfwwECOAQrwqym/3d4eHul7jAskluZILz7TuoCxhm77S6Kz7n4fO,parent-b:$2b$10$VISBwhELHuzSdsJTafvCk.kP.GXkFERn3mJcoceqQuWypO5x4Ur9K
# Browser origin allowed to call the API with cookies (local dev only)
ALLOWED_ORIGIN=http://localhost:4200
# Folder with the Angular build (default: dist/baby-tasting/browser)
# STATIC_DIR=
# Lets POST /api/v1/test/reset empty the database: end-to-end test databases only (ignored in production)
# E2E_RESET=1
# Cloudinary credentials for reaction photos (all three optional: without them the app runs and photos are off)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
